#!/bin/bash
# Runs mcpcli.py (next to this file) with `uv run --script`, which reads the
# script's inline metadata (PEP 723) and runs it in a cached environment with
# the pinned MCP python SDK, fetching Python itself if none is installed.
# Arguments are passed through; see `mcpcli --help`.
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)

exec uv run --quiet --script "$here/mcpcli.py" "$@"
