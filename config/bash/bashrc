# Interactive shells only (the guard is in ~/.bashrc). PATH and other exports
# live in config/bash/env, which login shells read too.
source ~/.config/bash/env

set -o vi

# use the best vi available
if command -v nvim > /dev/null 2>&1; then
  export EDITOR="nvim"
  alias vim='nvim'
  alias vi='nvim'
elif command -v vim > /dev/null 2>&1; then
  export EDITOR="vim"
  alias vi='vim'
elif command -v vi > /dev/null 2>&1; then
  export EDITOR="vi"
  alias vim='vi'
fi

if command -v pdftk > /dev/null 2>&1; then
  function pdftk_shuffle {
    pdftk A="$1" B="$2" shuffle A Bend-1 output "$3"
  }
fi

